# Hindsight memory backend (required)
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=deployment-memory

# LLM — Groq (used by the analysis agent)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ledger storage directory (default: ./data)
DATA_DIR=./data

# CORS — comma-separated list of additional allowed origins (optional)
# Localhost origins are always included by default.
# Example: CORS_ORIGINS=https://your-deploy.example.com,https://staging.example.com
CORS_ORIGINS=
